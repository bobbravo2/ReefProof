# Main configuration contains no secrets.
REEFPROOF_CONFIG_PATH=config/reefproof.example.yaml
REEFPROOF_TIMEZONE=America/New_York
REEFPROOF_DATA_DIRECTORY=.local/data
REEFPROOF_LOG_LEVEL=INFO
REEFPROOF_MODE=fixture
REEFPROOF_JSON_LOGS=false
REEFPROOF_API_BIND=127.0.0.1
REEFPROOF_API_PORT=8787

# OCI/LXC deployment contract:
# - the container receives REEFPROOF_DATA_DIRECTORY=/var/lib/reefproof;
# - the homelab runbook mounts the LXC host directory
#   /var/lib/reefproof/data at that container path;
# - deployment selects a GHCR image by immutable @sha256 digest in Ansible,
#   not through this file.
# Keep the scheduled v0.1 command credential-free (`infra-smoke --format json`)
# and its Podman network mode `none`.

# Future live HYDROS transport reads credentials only from environment or
# mounted secret files. Fixture mode ignores these unset names.
REEFPROOF_HYDROS_USERNAME=
REEFPROOF_HYDROS_PASSWORD=

# Required together only when YAML explicitly enables the home_assistant
# adapter. The complete endpoint is environment-authorized and must use an
# explicit loopback or private IP address. Hostnames, link-local/metadata
# addresses, URL credentials, fragments, and redirects are rejected.
REEFPROOF_HOME_ASSISTANT_ENDPOINT=
REEFPROOF_HOME_ASSISTANT_TOKEN=
# Optional: if unset, `reefproof serve` generates and prints a per-start
# bootstrap secret to stdout for one-time session establishment.
REEFPROOF_BOOTSTRAP_SECRET=
